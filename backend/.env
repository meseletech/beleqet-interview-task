# =============================================================================
# Beleqet Backend — Environment Variables
# =============================================================================

NODE_ENV=production
PORT=4000
FRONTEND_URL=https://your-frontend-url.com

# ✅ Render INTERNAL PostgreSQL URL (correct for Render backend)
DATABASE_URL="postgresql://beleqet_user:MyLrxCPKXqt4Rj4Fi9fu22TeN9uv1il8@dpg-d93bvataeets73a0mj2g-a.oregon-postgres.render.com:5432/beleqet_db_nrv7?sslmode=require"REDIS_HOST=localhost
REDIS_PORT=6379
